#!/usr/bin/env sh
# Public repo — private-reference check on the COMMIT MESSAGE itself.
#
# The rule "a public repo never names a private project" covers commit messages too; pre-commit
# only sees files. $1 is the file git hands us with the message being authored.
#
# The checker and its denylist live on the maintainer's machine, never here; see
# private-refs-checker.sh for the lookup and when it fails closed.
#
# Enable per clone: git config core.hooksPath .githooks
set -eu

# shellcheck source=private-refs-checker.sh
. "$(dirname -- "$0")/private-refs-checker.sh"

if [ -n "$PRIVATE_REFS_CHECKER" ]; then
  "$PRIVATE_REFS_CHECKER" "$1"
fi
