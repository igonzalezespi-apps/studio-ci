{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && scripts/hooks/bash-guard.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "core-dev@ivan": true,
    "studio-policy@ivan": true
  },
  "extraKnownMarketplaces": {
    "ivan": {
      "source": {
        "source": "github",
        "repo": "igonzalezespi-apps/claude-plugins",
        "ref": "main"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "core-dev:owner"
}
